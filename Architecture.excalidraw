    {
      "type": "text",
      "id": "col3_db_schema_t",
      "x": 960,
      "y": 830,
      "width": 300,
      "height": 300,
      "text": "DB Tables & Persistent Schemas:\n- receipt_records\n  (transaction_id, charged_amount, status,\n  requested, dispensed, state, owedChangeId)\n- settings\n  (pricing tiers, bulk configs, timeout TTL)\n- logs & anomaly_incidents\n  (audit logs, hardware disconnect events)\n- analysis_cache\n  (file hash, classification, coverage ratio)\n- balance & earnings\n  (current coins count, total sales, sales logs)",
      "originalText": "DB Tables & Persistent Schemas:\n- receipt_records\n  (transaction_id, charged_amount, status,\n  requested, dispensed, state, owedChangeId)\n- settings\n  (pricing tiers, bulk configs, timeout TTL)\n- logs & anomaly_incidents\n  (audit logs, hardware disconnect events)\n- analysis_cache\n  (file hash, classification, coverage ratio)\n- balance & earnings\n  (current coins count, total sales, sales logs)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
