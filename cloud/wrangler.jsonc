{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "printbit-admin-edge",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [
    {
      "binding": "PRINTBIT_STATE",
      "id": "printbit_state_kv"
    }
  ],
  "observability": {
    "enabled": true
  }
}
